<div class="container mt-5">
  <%- include('../partials/back-to-dashboard') %>
  <h1>Pending Members</h1>
  <p class="text-muted">New registrations that have verified their email and are awaiting approval.</p>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success" role="alert"><%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert"><%= error %></div>
  <% } %>

  <% if (members && members.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Registered</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr>
              <td><%= [m.first_name, m.last_name].filter(Boolean).join(' ') || '—' %></td>
              <td><%= m.email %></td>
              <td><time datetime="<%= m.created_at ? new Date(m.created_at).toISOString() : '' %>"><%= m.created_at ? new Date(m.created_at).toLocaleDateString() : '' %></time></td>
              <td>
                <div class="action-buttons">
                  <form method="POST" action="/admin/members/<%= m.id %>/approve">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                  </form>
                  <form method="POST" action="/admin/members/<%= m.id %>/reject">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-success">No members are awaiting approval.</p>
  <% } %>

</div>
