<%
  // Event times render in UTC, consistent with the controller's UTC month
  // windowing and the month label (backlog item 5).
  const timeFmt = (d) => d ? new Date(d).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' }) : '';
%>
<section class="calendar-page" role="region" aria-labelledby="calendar-heading">
  <div class="calendar-page-header">
    <h2 id="calendar-heading">Calendar</h2>
    <nav class="calendar-month-nav" aria-label="Month navigation">
      <a class="btn btn-secondary btn-sm" href="/calendar?month=<%= prevMonth %>" rel="prev">&larr; Previous</a>
      <span class="calendar-current-month"><%= currentMonthLabel %></span>
      <a class="btn btn-secondary btn-sm" href="/calendar?month=<%= nextMonth %>" rel="next">Next &rarr;</a>
    </nav>
  </div>

  <% if (!isMember) { %>
    <div class="calendar-members-prompt" role="note">
      <p>Some events are visible to members only. <a href="/login">Log in</a> to see members-only events.</p>
    </div>
  <% } %>

  <% if (!monthHasEvents) { %>
    <p class="no-events">No events scheduled this month.</p>
  <% } %>

  <div class="calendar-grid-wrap">
    <table class="calendar-grid">
      <caption class="calendar-grid-caption"><%= currentMonthLabel %></caption>
      <thead>
        <tr>
          <% weekdays.forEach(function(wd) { %>
            <th scope="col"><abbr title="<%= wd.full %>"><%= wd.short %></abbr></th>
          <% }); %>
        </tr>
      </thead>
      <tbody>
        <% weeks.forEach(function(week) { %>
          <tr>
            <% week.forEach(function(cell) { %>
              <% if (!cell) { %>
                <td class="calendar-cell calendar-cell--empty"></td>
              <% } else { %>
                <td class="calendar-cell<%= cell.isToday ? ' calendar-cell--today' : '' %>">
                  <span class="calendar-daynum"><%= cell.day %><% if (cell.isToday) { %> <span class="calendar-today-tag">(today)</span><% } %></span>
                  <% if (cell.events.length) { %>
                    <ul class="calendar-cell-events">
                      <% cell.events.forEach(function(event) { %>
                        <li class="calendar-event calendar-event--<%= event.type || 'event' %>">
                          <% if (event.date) { %><time class="calendar-event-time" datetime="<%= new Date(event.date).toISOString() %>"><%= timeFmt(event.date) %></time><% } %>
                          <span class="calendar-event-title"><%= event.title %></span>
                          <% if (event.visibility === 'members') { %><span class="badge badge-members">Members</span><% } %>
                          <% if (event.location) { %><span class="calendar-event-location"><span aria-hidden="true">📍</span> <%= event.location %></span><% } %>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </td>
              <% } %>
            <% }); %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<script src="/js/calendar.js"></script>
