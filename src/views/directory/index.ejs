<div class="directory-container">
    <h1>Member Directory</h1>
    <p class="subtitle">Connect with fellow members. <a href="/account/settings#directory-listing">Manage your own listing</a>.</p>

    <% if (typeof showNudge !== 'undefined' && showNudge) { %>
        <div class="directory-nudge" role="status">
            <p>You're not listed in the member directory yet. Add your listing so other members can find you.</p>
            <div class="directory-nudge-actions">
                <a href="/account/settings#directory-listing" class="btn-primary">Add my listing</a>
                <form method="POST" action="/directory/nudge/dismiss" class="nudge-dismiss">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="link-button">Dismiss</button>
                </form>
            </div>
        </div>
    <% } %>

    <div class="directory-filters">
        <form method="GET" action="/directory" role="search">
            <input type="text" id="directorySearchInput" name="search" placeholder="Search by name or interest..." value="<%= filters.search || '' %>" aria-label="Search members by name or interest" aria-controls="memberList">
            <button type="submit" class="directory-search-btn">Search</button>
        </form>
        <p class="directory-search-status" id="directorySearchStatus" role="status" aria-live="polite"></p>
    </div>

    <% if (typeof truncated !== 'undefined' && truncated) { %>
        <p class="directory-truncated-note" role="status">Showing the first <%= browseLimit %> members. Some listings aren't shown here — use a more specific search to find a member.</p>
    <% } %>

    <div class="directory-results">
        <% if (profiles && profiles.length > 0) { %>
            <ul class="member-list" id="memberList">
                <% profiles.forEach(profile => { %>
                    <li class="member-card">
                        <a class="member-card-link" href="/directory/<%= encodeURIComponent(profile.user_id) %>" aria-label="View profile: <%= profile.first_name %> <%= profile.last_name %>">
                            <%- include('../partials/initials-avatar', { initials: profile.initials }) %>
                            <div class="member-details">
                                <h2><%= profile.first_name %> <%= profile.last_name %></h2>
                                <% if (profile.interests) { %>
                                    <p class="member-interests"><%= profile.interests %></p>
                                <% } %>
                            </div>
                        </a>
                    </li>
                <% }) %>
            </ul>
            <!-- Shown by directory-search.js when the live filter matches nothing. -->
            <p class="directory-empty" id="directoryLiveEmpty" hidden>No members match your search. Try a different name or interest.</p>
        <% } else if (filters.search) { %>
            <p class="directory-empty">No members match "<%= filters.search %>". Try a different name or interest.</p>
        <% } else { %>
            <p class="directory-empty">No members are listed in the directory yet. <a href="/account/settings#directory-listing">Be the first to add your listing.</a></p>
        <% } %>
    </div>
</div>

<script src="/js/directory-search.js" defer></script>
