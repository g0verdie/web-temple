<%
  // Normalise a Date / ISO string to YYYY-MM-DDTHH:MM (UTC), then slice the date
  // and time parts for the split <input type="date"> / <input type="time"> fields
  // (backlog item 3). On a failed POST the raw split fields repopulate directly;
  // on edit they derive from the stored starts_at/ends_at.
  const toLocalInput = (value) => {
    if (!value) return '';
    const d = value instanceof Date ? value : new Date(value);
    if (isNaN(d.getTime())) return typeof value === 'string' ? value : '';
    return d.toISOString().slice(0, 16);
  };
  const toDateInput = (value) => { const s = toLocalInput(value); return s ? s.slice(0, 10) : ''; };
  const toTimeInput = (value) => { const s = toLocalInput(value); return s.length >= 16 ? s.slice(11, 16) : ''; };
  const startsDate = data.starts_date || toDateInput(data.starts_at || data.date);
  const startsTime = data.starts_time || toTimeInput(data.starts_at || data.date);
  const endsDate = data.ends_date || toDateInput(data.ends_at || data.endsAt);
  const endsTime = data.ends_time || toTimeInput(data.ends_at || data.endsAt);
  const visibilityValue = data.visibility || 'public';
  const typeValue = data.event_type || data.type || 'event';
  // Location dropdown (Temple / Custom) state (backlog item 4). A failed POST
  // carries location_choice/location_custom; edit carries the stored location.
  const TEMPLE_LOCATION = 'Temple';
  const currentLocation = data.location || '';
  const locationChoice = data.location_choice !== undefined
    ? data.location_choice
    : (currentLocation === TEMPLE_LOCATION ? 'Temple' : (currentLocation ? 'custom' : ''));
  const locationCustomValue = data.location_choice !== undefined
    ? (data.location_custom || '')
    : (currentLocation && currentLocation !== TEMPLE_LOCATION ? currentLocation : '');
  const locationIsTemple = locationChoice === 'Temple';
  const locationIsCustom = locationChoice === 'custom';
%>

  <div class="form-group">
    <label for="title">Title *</label>
    <input type="text" id="title" name="title" class="form-control"
      value="<%= data.title || '' %>" required aria-required="true" aria-describedby="title-help"
      data-preview-source="title">
    <span class="help-text" id="title-help">A short, descriptive event name.</span>
  </div>

  <div class="form-group">
    <label for="starts_date">Start Date *</label>
    <input type="date" id="starts_date" name="starts_date" class="form-control"
      value="<%= startsDate %>" required aria-required="true" aria-describedby="starts-date-help">
    <span class="help-text" id="starts-date-help">The day the event begins.</span>
  </div>

  <div class="form-group">
    <label for="starts_time">Start Time *</label>
    <input type="time" id="starts_time" name="starts_time" class="form-control"
      value="<%= startsTime %>" required aria-required="true" aria-describedby="starts-time-help">
    <span class="help-text" id="starts-time-help">When the event begins.</span>
  </div>

  <div class="form-group">
    <label for="ends_date">End Date (optional)</label>
    <input type="date" id="ends_date" name="ends_date" class="form-control"
      value="<%= endsDate %>" aria-describedby="ends-date-help">
    <span class="help-text" id="ends-date-help">Leave blank to default to one hour after the start.</span>
  </div>

  <div class="form-group">
    <label for="ends_time">End Time (optional)</label>
    <input type="time" id="ends_time" name="ends_time" class="form-control"
      value="<%= endsTime %>" aria-describedby="ends-time-help">
    <span class="help-text" id="ends-time-help">Only used when an end date is set.</span>
  </div>

  <div class="form-group">
    <label for="visibility">Visibility *</label>
    <select id="visibility" name="visibility" class="form-control" aria-describedby="visibility-help">
      <option value="public" <%= visibilityValue === 'public' ? 'selected' : '' %>>Public (everyone)</option>
      <option value="members" <%= visibilityValue === 'members' ? 'selected' : '' %>>Members only (logged-in)</option>
    </select>
    <span class="help-text" id="visibility-help">Members-only events are hidden from the public calendar.</span>
  </div>

  <div class="form-group">
    <label for="event_type">Event Type *</label>
    <select id="event_type" name="event_type" class="form-control" aria-describedby="type-help">
      <option value="event" <%= typeValue === 'event' ? 'selected' : '' %>>Event</option>
      <option value="service" <%= typeValue === 'service' ? 'selected' : '' %>>Service</option>
    </select>
    <span class="help-text" id="type-help">Services drive the homepage "Next Service" countdown.</span>
  </div>

  <div class="form-group">
    <label for="location_choice">Location (optional)</label>
    <select id="location_choice" name="location_choice" class="form-control"
      aria-describedby="location-help" data-location-select>
      <option value="" <%= locationChoice === '' ? 'selected' : '' %>>— None —</option>
      <option value="Temple" <%= locationIsTemple ? 'selected' : '' %>>Temple</option>
      <option value="custom" <%= locationIsCustom ? 'selected' : '' %>>Custom…</option>
    </select>
    <span class="help-text" id="location-help">Choose Temple, or Custom to enter another location.</span>
  </div>

  <div class="form-group" data-location-custom <%= locationIsCustom ? '' : 'hidden' %>>
    <label for="location_custom">Custom Location</label>
    <input type="text" id="location_custom" name="location_custom" class="form-control"
      value="<%= locationCustomValue %>" aria-describedby="location-custom-help">
    <span class="help-text" id="location-custom-help">e.g. Community Center, 123 Main St.</span>
  </div>

  <div class="form-group">
    <label for="zoom_url">Zoom / Meeting Link (optional)</label>
    <input type="url" id="zoom_url" name="zoom_url" class="form-control"
      value="<%= data.zoom_url || data.zoomUrl || '' %>" aria-describedby="zoom-help">
    <span class="help-text" id="zoom-help">A meeting link for online attendance.</span>
  </div>

  <div class="form-group">
    <label for="description">Description (optional)</label>
    <textarea id="description" name="description" class="form-control" rows="4"
      aria-describedby="description-help" data-preview-source="description"><%= data.description || '' %></textarea>
    <span class="help-text" id="description-help">Details shown to members on the calendar.</span>
  </div>
