<div class="directory-container member-profile">
    <p><a href="/directory">&larr; Back to directory</a></p>

    <div class="member-profile-header">
        <%- include('../partials/initials-avatar', { initials: profile.initials }) %>
        <h1><%= profile.first_name %> <%= profile.last_name %></h1>
    </div>

    <% if (profile.bio) { %>
        <section class="member-section" aria-labelledby="bio-heading">
            <h2 id="bio-heading">About</h2>
            <p><%= profile.bio %></p>
        </section>
    <% } %>

    <% if (profile.interests) { %>
        <section class="member-section" aria-labelledby="interests-heading">
            <h2 id="interests-heading">Committees &amp; Interests</h2>
            <p><%= profile.interests %></p>
        </section>
    <% } %>

    <% if (profile.household && profile.household.length > 0) { %>
        <section class="member-section" aria-labelledby="household-heading">
            <h2 id="household-heading">Household</h2>
            <ul class="member-household">
                <% profile.household.forEach(function (person) { %>
                    <li>
                        <span class="household-name"><%= person.name %></span><% if (person.relationship) { %> &mdash; <%= person.relationship %><% } %><% if (person.birthday) { %> <span class="household-birthday">(<%= person.birthday %>)</span><% } %>
                    </li>
                <% }); %>
            </ul>
        </section>
    <% } %>

    <% if (profile.birthday) { %>
        <section class="member-section" aria-labelledby="birthday-heading">
            <h2 id="birthday-heading">Birthday</h2>
            <p><%= profile.birthday %></p>
        </section>
    <% } %>

    <% if (profile.email || profile.phone || profile.address) { %>
        <section class="member-section" aria-labelledby="contact-heading">
            <h2 id="contact-heading">Contact</h2>
            <ul class="member-contact">
                <% if (profile.email) { %>
                    <li>Email: <a href="mailto:<%= profile.email %>"><%= profile.email %></a></li>
                <% } %>
                <% if (profile.phone) { %>
                    <li>Phone: <a href="tel:<%= profile.phone %>"><%= profile.phone %></a></li>
                <% } %>
                <% if (profile.address) { %>
                    <li>Address: <%= profile.address %></li>
                <% } %>
            </ul>
        </section>
    <% } %>
</div>
