<div class="archive-container">
    <h1>Recording Archive</h1>
    <div class="archive-filters">
        <form method="GET" action="/archive">
            <input type="text" name="search" placeholder="Search keywords..." value="<%= filters.search || '' %>" aria-label="Search keywords">
            <select name="serviceType" aria-label="Service Type">
                <option value="">All Services</option>
                <option value="Shabbat" <%= filters.serviceType === 'Shabbat' ? 'selected' : '' %>>Shabbat</option>
                <option value="Holiday" <%= filters.serviceType === 'Holiday' ? 'selected' : '' %>>Holiday</option>
                <option value="Special Event" <%= filters.serviceType === 'Special Event' ? 'selected' : '' %>>Special Event</option>
            </select>
            <input type="text" name="torahPortion" placeholder="Torah Portion" value="<%= filters.torahPortion || '' %>" aria-label="Torah Portion">
            <input type="date" name="startDate" value="<%= filters.startDate || '' %>" aria-label="Start Date">
            <input type="date" name="endDate" value="<%= filters.endDate || '' %>" aria-label="End Date">
            <button type="submit">Filter</button>
        </form>
    </div>

    <div class="archive-results">
        <% if (recordings && recordings.length > 0) { %>
            <ul class="recording-list">
                <% recordings.forEach(recording => { %>
                    <li class="recording-card">
                        <a class="recording-card-link" href="/archive/<%= encodeURIComponent(recording.id) %>" aria-label="Play recording: <%= recording.title %>">
                            <% if (recording.preview_url) { %>
                                <img src="<%= recording.preview_url %>" alt="" class="recording-thumbnail">
                            <% } %>
                            <div class="recording-details">
                                <h2><%= recording.title %></h2>
                            <p class="date">
                                <% if (recording.service_date && !isNaN(new Date(recording.service_date).getTime())) { %>
                                    <%= new Date(recording.service_date).toLocaleDateString() %>
                                <% } else { %>
                                    Date unavailable
                                <% } %>
                            </p>
                            <p class="rabbi">Rabbi: <%= (recording.first_name && (recording.first_name + (recording.last_name ? ' ' + recording.last_name : '')).trim()) || 'Rabbi' %></p>
                            <% if (recording.torah_portion) { %>
                                <p class="portion">Portion: <%= recording.torah_portion %></p>
                            <% } %>
                            <% const durationRaw = typeof recording.duration_seconds === 'string' ? recording.duration_seconds.trim() : recording.duration_seconds; %>
                            <% if (durationRaw !== '' && durationRaw !== null && durationRaw !== undefined && Number.isFinite(Number(durationRaw))) { %>
                                <p class="duration">Duration: <%= Math.floor(Math.max(0, Number(durationRaw)) / 60) %> mins</p>
                            <% } else { %>
                                <p class="duration">Duration: N/A</p>
                            <% } %>
                            <p class="description"><%= recording.description %></p>
                            </div>
                        </a>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No recordings found matching your filters.</p>
        <% } %>
    </div>

    <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (currentPage > 1) { %>
                <a href="/archive?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(filters.search || '') %>&serviceType=<%= encodeURIComponent(filters.serviceType || '') %>&torahPortion=<%= encodeURIComponent(filters.torahPortion || '') %>&startDate=<%= encodeURIComponent(filters.startDate || '') %>&endDate=<%= encodeURIComponent(filters.endDate || '') %>" rel="prev">Previous</a>
            <% } %>
            <span>Page <%= currentPage %> of <%= totalPages %></span>
            <% if (currentPage < totalPages) { %>
                <a href="/archive?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(filters.search || '') %>&serviceType=<%= encodeURIComponent(filters.serviceType || '') %>&torahPortion=<%= encodeURIComponent(filters.torahPortion || '') %>&startDate=<%= encodeURIComponent(filters.startDate || '') %>&endDate=<%= encodeURIComponent(filters.endDate || '') %>" rel="next">Next</a>
            <% } %>
        </div>
    <% } %>

    <% if (showOlderRecordingsNotice) { %>
        <div class="archive-notice">
            <p>Available on request - contact Rabbi for older recordings.</p>
        </div>
    <% } %>
</div>
