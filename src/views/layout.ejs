<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= title %> - A warm, inclusive Jewish community in Hattiesburg, MS">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  
  <header role="banner">
    <nav role="navigation" aria-label="Main navigation">
      <div class="nav-container">
        <h1 class="site-title">Temple B'nai Israel</h1>
        <button class="hamburger-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <ul class="nav-menu" id="nav-menu">
          <li><a href="/" aria-current="page">Home</a></li>
          <li><a href="/calendar">Calendar</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <main id="main-content" role="main">
    <%- include(bodyView, viewData) %>
  </main>

  <footer role="contentinfo">
    <div class="footer-container">
      <p>&copy; <%= new Date().getFullYear() %> Temple B'nai Israel. All rights reserved.</p>
      <p>5371 U.S. 49, Hattiesburg, MS 39401</p>
    </div>
  </footer>

  <script src="/js/hamburger.js"></script>
</body>
</html>
