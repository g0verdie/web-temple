<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    // Per-page meta with a site-wide default. `description` is optional, so every
    // existing res.render('layout', ...) keeps working untouched.
    const siteName = "Temple B'nai Israel";
    const defaultDescription = "Temple B'nai Israel — a warm, inclusive Jewish community in Florence, AL. Join us for services, streaming, events, and community life.";
    const metaDescription = (typeof description !== 'undefined' && description) ? description : defaultDescription;
    const siteUrl = (typeof baseUrl !== 'undefined' && baseUrl) ? baseUrl : '';
    const canonicalPath = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '';
    const canonicalUrl = siteUrl + canonicalPath;
    const ogImage = siteUrl + '/images/og-share.jpg';
    // Brand the title with the site name unless the page already includes it
    // (auth pages suffix the brand themselves — avoid double-branding).
    const brandedTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
    // Sitewide structured data (schema.org PlaceOfWorship), always emitted.
    const siteJsonLd = {
      '@context': 'https://schema.org',
      '@type': 'PlaceOfWorship',
      name: siteName,
      url: siteUrl || undefined,
      logo: siteUrl + '/images/tbi-logo.png',
      image: ogImage,
      description: defaultDescription,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '201 E Hawthorne St',
        addressLocality: 'Florence',
        addressRegion: 'AL',
        postalCode: '35630',
        addressCountry: 'US'
      }
    };
    // Embed JSON safely inside a script tag: escape chars that could break out of
    // the element (a literal closing tag in untrusted data) or confuse the HTML parser.
    const ldJson = (obj) => JSON.stringify(obj)
      .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
  %>
  <meta name="description" content="<%= metaDescription %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %>
    <meta name="robots" content="noindex">
    <% } %>
  <% if (typeof csrfToken !=='undefined' ) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
      <title>
        <%= brandedTitle %>
      </title>
      <link rel="canonical" href="<%= canonicalUrl %>">

      <!-- Open Graph / Facebook -->
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="<%= siteName %>">
      <meta property="og:title" content="<%= brandedTitle %>">
      <meta property="og:description" content="<%= metaDescription %>">
      <meta property="og:url" content="<%= canonicalUrl %>">
      <meta property="og:image" content="<%= ogImage %>">

      <!-- Twitter Card -->
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="<%= brandedTitle %>">
      <meta name="twitter:description" content="<%= metaDescription %>">
      <meta name="twitter:image" content="<%= ogImage %>">

      <link rel="icon" type="image/svg+xml" href="/favicon.svg">
      <!-- Main CSS -->
      <link rel="stylesheet" href="/css/main.css">
      <% if (typeof stylesheets !=='undefined' && stylesheets.length) { %>
        <% stylesheets.forEach((stylesheet)=> { %>
          <link rel="stylesheet" href="<%= stylesheet %>">
          <% }) %>
            <% } %>

              <!-- Structured data (schema.org). Server-built JSON, not executable script — CSP-safe as data. -->
              <script type="application/ld+json"><%- ldJson(siteJsonLd) %></script>
              <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
                <script type="application/ld+json"><%- ldJson(jsonLd) %></script>
                <% } %>
</head>

<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header role="banner">
    <nav role="navigation" aria-label="Main navigation">
      <div class="nav-container">
        <h1 class="site-title">
          <a href="/" class="site-logo-link" aria-label="Temple B'nai Israel — home">
            <img src="/images/tbi-logo.png" alt="Temple B'nai Israel" class="site-logo" width="600" height="137">
            <svg class="site-home-icon" viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
          </a>
        </h1>
        <button class="hamburger-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <% const activePath=(typeof currentPath !=='undefined' ? currentPath : '' ); %>
          <ul class="nav-menu" id="nav-menu">
            <li><a href="/" <%=activePath==='/' ? 'aria-current="page"' : '' %>>Home</a></li>
            <li><a href="/calendar" <%=activePath==='/calendar' ? 'aria-current="page"' : '' %>>Calendar</a></li>
            <li><a href="/watch" <%=activePath==='/watch' ? 'aria-current="page"' : '' %>>Watch</a></li>
            <li><a href="/about" <%=activePath==='/about' ? 'aria-current="page"' : '' %>>About</a></li>
            <li><a href="/contact" <%=activePath==='/contact' ? 'aria-current="page"' : '' %>>Contact</a></li>
            <li><a href="/donations" class="nav-donate" <%=activePath==='/donations' ? 'aria-current="page"' : '' %>>Donate</a></li>
            <% if (user) { %>
            <li><a href="/directory" <%=activePath==='/directory' ? 'aria-current="page"' : '' %>>Directory</a></li>
            <li><a href="/account/settings" <%=activePath==='/account/settings' ? 'aria-current="page"' : '' %>>Account</a></li>
            <% if (user.role === 'admin' || user.role === 'rabbi') { %>
            <li><a href="/admin" <%=activePath==='/admin' ? 'aria-current="page"' : '' %>>Admin</a></li>
            <% } %>
            <li><a href="/login" class="nav-logout" id="logout-link">Logout</a></li>
            <% } else { %>
            <li><a href="/login" class="nav-login" <%=activePath==='/login' ? 'aria-current="page"' : '' %>>Login</a></li>
            <% } %>
          </ul>
      </div>
    </nav>
  </header>

  <main id="main-content" role="main">
    <%- include(bodyView, viewData) %>
  </main>

  <footer role="contentinfo">
    <div class="footer-container">
      <p>&copy; <%= new Date().getFullYear() %> Temple B'nai Israel. All rights reserved.</p>
      <p>201 E Hawthorne St, Florence, AL 35630</p>
      <nav class="footer-links" aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
        <a href="/accessibility">Accessibility</a>
      </nav>
    </div>
  </footer>

  <script src="/js/hamburger.js"></script>
  <% if (typeof user !== 'undefined' && user) { %>
    <script src="/js/sessionWarning.js"></script>
    <script src="/js/logout.js"></script>
  <% } %>
</body>

</html>