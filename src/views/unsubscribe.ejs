<div class="container account-settings">
    <h1>Unsubscribe</h1>
    <p class="subtitle">We are updating your email preferences.</p>

    <div id="unsubscribeAlert" class="alert" role="alert">Processing your request...</div>
    <input type="hidden" id="unsubscribeToken" value="<%= token %>">

    <p>Changed your mind? You can re-enable notifications any time from your
        <a href="/account/settings">account settings</a>.</p>
</div>

<script src="/js/unsubscribe.js" defer></script>
