<!-- Hero Section with Mission Statement -->
<section class="hero" role="region" aria-labelledby="hero-heading">
  <div class="hero-content">
    <img src="/images/tbi-logo.png" alt="" class="hero-logo" width="600" height="137">
    <h2 id="hero-heading" class="hero-headline"><%= mission.headline %></h2>
    <p class="hero-mission"><%= mission.statement %></p>
    <a href="<%= mission.cta.link %>" class="cta-button" role="button">
      <%= mission.cta.text %>
    </a>
  </div>
</section>

<!-- Live Stream -->
<section class="stream-section" role="region" aria-labelledby="stream-heading" id="live-stream-container">
  <div class="stream-header">
    <h3 id="stream-heading" class="section-title">Live Stream</h3>
    <% if (stream && stream.statusLabel) { %>
      <span class="stream-badge stream-badge--<%= stream.status %>" role="status" aria-live="polite" aria-atomic="true" aria-label="<%= stream.statusLabel %>"><%= stream.statusLabel %></span>
    <% } %>
  </div>

  <% if (stream && stream.status === 'live' && stream.embedUrl) { %>
    <% const chatEnabled = !!stream.id; /* env-var fallback path has no DB id; chat needs a real stream id */ %>
    <% if (chatEnabled) { %><link rel="stylesheet" href="/css/live-chat.css"><% } %>
    <div class="stream-container-layout">
      <div class="stream-card">
        <div class="stream-player-frame">
          <iframe
            src="<%= stream.embedUrl %>"
            title="<%= stream.iframeTitle %>"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="eager"
            referrerpolicy="no-referrer">
          </iframe>
        </div>
        <div class="stream-details">
          <p class="stream-title"><%= stream.title %></p>
          <% if (stream.message) { %>
            <p class="stream-helper"><%= stream.message %></p>
          <% } %>
          <% if (stream.watchUrl) { %>
            <a href="<%= stream.watchUrl %>" class="stream-link">Watch on Facebook</a>
          <% } %>
        </div>
      </div>

      <% if (chatEnabled) { %>
      <!-- Live Chat Panel -->
      <div id="live-chat-panel"
           data-stream-id="<%= stream.id %>"
           data-logged-in="<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>"
           data-current-user-id="<%= typeof user !== 'undefined' && user ? user.id : '' %>"
           data-role="<%= typeof user !== 'undefined' && user ? user.role : 'guest' %>">
      </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="stream-card stream-card--fallback">
      <% if (stream && stream.title) { %>
        <p class="stream-title"><%= stream.title %></p>
      <% } %>
      <p class="stream-helper"><%= stream.message %></p>
      
      <% if (stream && stream.status === 'upcoming' && stream.formattedScheduledStart) { %>
        <p class="stream-schedule">Next scheduled stream: <%= stream.formattedScheduledStart %></p>
        <div class="stream-countdown" data-countdown-target="<%= stream.countdownTarget %>" role="status" aria-live="polite" aria-atomic="true">
          <!-- Countdown managed by external script -->
        </div>
      <% } %>

      <% if (stream && stream.status === 'error' && stream.fallbackUrl) { %>
        <a href="<%= stream.fallbackUrl %>" class="stream-link cta-button">Watch on Facebook</a>
      <% } %>

      <% if (stream && stream.status === 'offline' && stream.archiveCta) { %>
        <a href="/archive" class="stream-link cta-button">View Recordings</a>
      <% } %>
    </div>
  <% } %>
</section>

<!-- Countdown Timer to Next Service -->
<% if (nextService && countdown && !(stream && stream.status === 'upcoming')) { %>
<section class="countdown-section" role="region" aria-labelledby="countdown-heading">
  <h3 id="countdown-heading" class="section-title">Next Service</h3>
  <div class="service-info">
    <p class="service-title"><%= nextService.title %></p>
    <p class="service-date" aria-label="Service date and time">
      <%= formatEventDate(nextService.date) %>
    </p>
  </div>

  <div class="countdown-timer"
       role="timer"
       aria-live="polite"
       aria-atomic="true"
       data-service-date="<%= nextService.date.toISOString() %>">
    <div class="countdown-unit">
      <span class="countdown-value" id="countdown-days" aria-label="Days"><%= countdown.days %></span>
      <span class="countdown-label">Days</span>
    </div>
    <div class="countdown-unit">
      <span class="countdown-value" id="countdown-hours" aria-label="Hours"><%= countdown.hours %></span>
      <span class="countdown-label">Hours</span>
    </div>
    <div class="countdown-unit">
      <span class="countdown-value" id="countdown-minutes" aria-label="Minutes"><%= countdown.minutes %></span>
      <span class="countdown-label">Minutes</span>
    </div>
    <div class="countdown-unit">
      <span class="countdown-value" id="countdown-seconds" aria-label="Seconds"><%= countdown.seconds %></span>
      <span class="countdown-label">Seconds</span>
    </div>
  </div>
</section>
<% } %>

<!-- Upcoming Events -->
<section class="events-section" role="region" aria-labelledby="events-heading">
  <h3 id="events-heading" class="section-title">Upcoming Events</h3>

  <% if (events && events.length > 0) { %>
    <ul class="events-list" role="list">
      <% events.forEach((event, index) => { %>
        <li class="event-card" role="listitem">
          <h4 class="event-title"><%= event.title %></h4>
          <p class="event-date">
            <time datetime="<%= event.date.toISOString() %>">
              <%= event.formattedDate %>
            </time>
          </p>
          <p class="event-description"><%= event.description %></p>
          <p class="event-location" aria-label="Event location">
            <span aria-hidden="true">📍</span> <%= event.location %>
          </p>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="no-events">No upcoming events at this time. Check back soon!</p>
  <% } %>
</section>

<!-- Announcements (Epic 5) -->
<section class="announcements-section" role="region" aria-labelledby="announcements-heading">
  <h3 id="announcements-heading" class="section-title">Announcements</h3>

  <% const announcementList = (typeof announcements !== 'undefined' && announcements) ? announcements : []; %>
  <% if (announcementList.length > 0) { %>
    <ul class="announcements-list" role="list">
      <% announcementList.forEach((announcement) => { %>
        <li class="announcement-card <%= announcement.isFeatured ? 'announcement-card--featured' : '' %>" role="listitem">
          <h4 class="announcement-card__title">
            <%= announcement.title %>
            <% if (announcement.isFeatured) { %><span class="announcement-badge">Featured</span><% } %>
          </h4>
          <p class="announcement-card__meta">
            <time datetime="<%= new Date(announcement.published_at).toISOString() %>">
              <%= new Date(announcement.published_at).toLocaleDateString() %>
            </time>
            <% if (announcement.wasEdited) { %>
              <span class="announcement-updated">&middot; Updated: <%= new Date(announcement.updated_at).toLocaleDateString() %></span>
            <% } %>
          </p>
          <details class="announcement-details">
            <summary>Read announcement</summary>
            <!-- body_html is server-sanitized on write (AnnouncementService KTD2); safe to render raw. -->
            <div class="announcement-card__body"><%- announcement.body_html %></div>
          </details>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="no-announcements">No announcements at this time. Check back soon!</p>
  <% } %>
</section>

<!-- Client-side logic for countdown timer and stream parsing -->
<script src="/js/stream-status.js"></script>
<% if (stream && stream.status === 'live' && stream.embedUrl && stream.id) { %>
<script src="/js/live-chat.js"></script>
<% } %>
