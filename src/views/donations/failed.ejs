<div class="donations-container">
    <h1>Your payment couldn't be completed</h1>
    <p>No charge was made. This can happen for a few reasons — please try again.</p>
    <div class="failed-actions">
        <a href="/donations/checkout/<%= encodeURIComponent(donationId) %>" class="btn-primary">Retry Payment</a>
        <a href="/donations" class="btn-link">Start over</a>
    </div>
</div>
