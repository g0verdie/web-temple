<div class="container mt-5">
    <h1>Admin Dashboard</h1>

    <div class="row mt-4">
        <!-- Backup Status Card -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">System Status</h5>
                </div>
                <div class="card-body">
                    <% if (latestAttempt && latestAttempt.status !=='SUCCESS' ) { %>
                        <div class="alert alert-danger mb-3">
                            <strong>⚠️ Backup Failure Detected</strong><br>
                            Last attempt: <%= new Date(latestAttempt.timestamp).toLocaleString() %><br>
                                Error: <%= latestAttempt.message %>
                        </div>
                        <% } %>

                            <h6>Last Successful Backup</h6>
                            <% if (lastBackup) { %>
                                <div class="alert alert-success">
                                    <strong>Success</strong><br>
                                    Time: <%= new Date(lastBackup.timestamp).toLocaleString() %><br>
                                        Size: <%= (lastBackup.size_bytes / 1024 / 1024).toFixed(2) %> MB
                                </div>
                                <% } else { %>
                                    <div class="alert alert-warning">
                                        No successful backups found.
                                    </div>
                                    <% } %>

                                        <hr>
                                        <a href="/admin/pages" class="btn btn-outline-primary me-2">Manage Pages</a>
                                        <a href="/admin/audit-logs" class="btn btn-outline-secondary">Audit Logs</a>
                </div>
            </div>
        </div>

        <!-- Email Queue Status Card -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Email Queue</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <p class="mb-1"><strong>Waiting:</strong> <%= emailQueue?.counts?.waiting ?? 0 %></p>
                            <p class="mb-1"><strong>Active:</strong> <%= emailQueue?.counts?.active ?? 0 %></p>
                            <p class="mb-1"><strong>Delayed:</strong> <%= emailQueue?.counts?.delayed ?? 0 %></p>
                        </div>
                        <div class="col-6">
                            <p class="mb-1"><strong>Failed:</strong> <%= emailQueue?.counts?.failed ?? 0 %></p>
                            <p class="mb-1"><strong>Completed:</strong> <%= emailQueue?.counts?.completed ?? 0 %></p>
                        </div>
                    </div>

                    <hr>

                    <% if (emailQueue?.failed?.length) { %>
                        <h6>Failed Jobs</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Recipient</th>
                                        <th>Attempts</th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% emailQueue.failed.forEach(job => { %>
                                        <tr>
                                            <td><%= job.id %></td>
                                            <td><%= job.data?.to || 'N/A' %></td>
                                            <td><%= job.attemptsMade %></td>
                                            <td><%= job.failedReason || 'Unknown' %></td>
                                            <td>
                                                <form method="POST" action="/admin/email-queue/<%= job.id %>/retry">
                                                    <button class="btn btn-sm btn-warning" type="submit">Retry</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="alert alert-success mb-0">
                            No failed email jobs.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Rabbi Tools Card Component (Only visible to Rabbi role) -->
        <% if (user && user.role === 'rabbi') { %>
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Rabbi Tools</h5>
                    <button id="replay-tour-btn" class="btn btn-sm btn-light">Replay Tour</button>
                </div>
                <div class="card-body">
                    <a href="#" id="tour-announcements" class="btn btn-primary me-2 mb-2">Post Announcement</a>
                    <a href="#" id="tour-calendar" class="btn btn-primary me-2 mb-2">Manage Calendar</a>
                    <a href="#" id="tour-messages" class="btn btn-primary me-2 mb-2">Message Inbox</a>
                </div>
            </div>
            <!-- Include driver.js for the onboarding tour -->
            <script src="https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.js.iife.js"></script>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.css"/>
            <script>
                window.USER_ONBOARDING_COMPLETE = <%= user.onboarding_complete || false %>;
            </script>
            <script src="/js/adminTour.js"></script>
        </div>
        <% } %>
    </div>
</div>