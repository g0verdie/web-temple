<section class="about-page">
  <!-- Hero Section -->
  <section class="about-hero" role="region" aria-labelledby="about-heading">
    <div class="container">
      <h1 id="about-heading" class="about-hero__title">About Temple B'nai Israel</h1>
      <p class="about-hero__subtitle">Discover our history, values, and mission</p>
    </div>
  </section>

  <!-- About Content -->
  <section class="about-content" role="region" aria-labelledby="content-heading">
    <div class="container about-content__wrapper">
      <article class="about-content__main">
        <h2 id="content-heading" class="sr-only">Temple Information</h2>

        <!-- Rich Text Content from CMS -->
        <div class="prose prose--rich-text">
          <%- page.content %>
        </div>

        <!-- Publication Status -->
        <% if (!page.published) { %>
          <div class="alert alert-warning" role="status" aria-live="polite">
            <strong>Draft:</strong> This page is not yet published and is visible only to administrators.
          </div>
          <% } %>
      </article>

      <!-- Sidebar (optional) -->
      <aside class="about-sidebar" role="complementary" aria-label="Additional information">
        <nav class="about-sidebar__nav">
          <h3 class="about-sidebar__title">Quick Links</h3>
          <ul class="about-sidebar__list">
            <li><a href="/" class="about-sidebar__link">Home</a></li>
            <li><a href="/contact" class="about-sidebar__link">Contact Us</a></li>
            <li><span class="about-sidebar__link disabled" aria-disabled="true">Services & Events (Coming Soon)</span>
            </li>
            <li><span class="about-sidebar__link disabled" aria-disabled="true">Support Us (Coming Soon)</span></li>
          </ul>
        </nav>

        <!-- Contact Card -->
        <div class="contact-card">
          <h3 class="contact-card__title">Get in Touch</h3>
          <p class="contact-card__text">Have questions? We'd love to hear from you.</p>
          <a href="/contact" class="btn btn--primary btn--block">Contact Us</a>
        </div>
      </aside>
    </div>
  </section>
</section>

<!-- Inline styles moved to /css/about.css -->
<link rel="stylesheet" href="/css/about.css">