# Environment Configuration
NODE_ENV=development
PORT=3000

# Server Configuration
HOST=localhost

# Absolute public base URL (scheme + host, no trailing slash) used to build
# absolute URLs for SEO/social tags: <link rel="canonical">, Open Graph/Twitter
# og:url + og:image, and the sitemap.xml <loc> entries. Set this to the real
# production origin (e.g. https://www.templebnaiisrael.org). When unset, these
# URLs fall back to the incoming request's protocol + host.
# SITE_URL=https://www.example.org

# Field-level encryption key — REQUIRED. Encrypts sensitive data at rest
# (donation amounts/donor emails, member PII). Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, donations and any encrypted-field write fail at runtime.
ENCRYPTION_KEY=

# Timezone offset for parsing datetime-local form inputs (Story 3.6)
# Set to the congregation's UTC offset (e.g., -05:00 for CDT, -06:00 for CST).
# Required when the server runs in UTC (Docker, Heroku, AWS) to prevent
# scheduled stream times from shifting. Leave unset if the server's TZ
# matches the congregation's timezone.
# APP_TIMEZONE_OFFSET=-05:00

# IANA timezone the temple's event/stream times are DISPLAYED in (utils/templeTime).
# Distinct from APP_TIMEZONE_OFFSET above: this is an IANA zone name (not a fixed
# offset) so display is DST-correct (CST/CDT). Defaults to America/Chicago when unset.
# TEMPLE_TIMEZONE=America/Chicago

# Donations (Epic 8)
# PAYMENT_PROVIDER selects the payment integration. Defaults to "mock" (the MVP /
# Board-demo simulated provider — no real money). Switch to "paypal" once the Board
# authorizes live credentials and the PayPalProvider is implemented.
# PAYMENT_PROVIDER=mock
# Tax-receipt identity — REAL VALUES REQUIRED before issuing any real receipt (FR115):
# TEMPLE_LEGAL_NAME=Temple B'nai Israel
# TEMPLE_EIN=00-0000000
# TEMPLE_ADDRESS=201 E Hawthorne St, Florence, AL 35630

# Past Services / Facebook video archive (public /watch page)
# PAST_VIDEO_SOURCE selects where past videos come from. Defaults to "curated"
# (the committed list in src/services/pastVideos/curatedVideos.js — the MVP/demo
# source, no Facebook credentials needed). Switch to "graph" to auto-pull from the
# temple's Facebook Page once a Page Access Token lands.
# PAST_VIDEO_SOURCE=curated
#
# Graph source credentials (only needed when PAST_VIDEO_SOURCE=graph):
#  - FACEBOOK_PAGE_ID must be the NUMERIC Page ID (not a vanity name or share-slug —
#    a non-numeric value produces non-embeddable URLs and every card renders blank).
#  - FACEBOOK_PAGE_ACCESS_TOKEN is a long-lived Page Access Token (a secret — never
#    commit it). Reading the temple's own page needs pages_read_engagement +
#    pages_show_list (no full App Review). It is sent via the Authorization header.
#  - FACEBOOK_GRAPH_API_VERSION pins the Graph API version (defaults to v21.0).
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_API_VERSION=v21.0
#
# Cache TTLs (seconds): success list cache and the shorter outage/negative cache.
# PAST_VIDEO_CACHE_TTL_SECONDS=21600
# PAST_VIDEO_FALLBACK_TTL_SECONDS=900

# Error monitoring (Sentry) — OPTIONAL and OFF by default.
# Leave SENTRY_DSN unset to disable Sentry entirely (no events are sent and no
# extra handlers run). Set it to the project DSN from sentry.io to turn on
# server-side error capture. Sentry is always disabled under NODE_ENV=test.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT distinguishes events by environment in the Sentry UI
# (defaults to NODE_ENV when unset). e.g. production, staging.
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE is the performance-tracing sample rate, 0.0–1.0
# (defaults to 0 = tracing off; error capture works regardless).
# SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# Authentication secret — REQUIRED outside the test environment.
# Signs the JWT stored in the httpOnly auth_token cookie. Generate a long
# random value; rotating it logs everyone out. Under NODE_ENV=test the code
# falls back to a fixed 'test-jwt-secret', so this is only mandatory for
# dev/staging/production. Also the default secret for UNSUBSCRIBE_TOKEN_SECRET
# below when that is unset.
# JWT_SECRET=

# ---------------------------------------------------------------------------
# Postgres connection. The app (src/config/db.js) reads DATABASE_URL; the
# scripts (migrate, create-admin, check_indexes) read the discrete DB_* vars
# below. Set whichever your environment uses — DATABASE_URL is preferred for
# the server, the DB_* set is needed to run the npm scripts.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/web_temple
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=web_temple
# DB_USER=temple_user
# DB_PASSWORD=

# Redis connection (caching + Bull email/reminder queues). Defaults to
# redis://localhost:6379 when unset; ignored under NODE_ENV=test (mocked).
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Outbound email (nodemailer SMTP transport, src/services/emailService.js).
# Required to actually deliver contact-form, donation-receipt, and reminder
# email. SMTP_SECURE=true for implicit TLS (port 465), false for STARTTLS
# (port 587). SMTP_FROM is the From: header; SMTP_USER doubles as a fallback
# recipient for some admin notifications.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Temple B'nai Israel" <no-reply@example.org>

# ---------------------------------------------------------------------------
# Notification recipients. CONTACT_EMAIL receives contact-form submissions and
# is the fallback for admin/rabbi notifications. ADMIN_EMAIL / RABBI_EMAIL
# route donation alerts and operational notices (donationController,
# emailQueueService, PastVideoService). Each falls back to the next when unset
# (RABBI_EMAIL -> ADMIN_EMAIL -> CONTACT_EMAIL -> SMTP_USER).
# CONTACT_EMAIL=info@example.org
# ADMIN_EMAIL=admin@example.org
# RABBI_EMAIL=rabbi@example.org

# ---------------------------------------------------------------------------
# Absolute app URLs used to build links in emails, iCal feeds, and calendar
# CTAs (reminderWorker, EventService, emailTemplateService, userService,
# AnnouncementService, icalService). Both default to http://localhost:3000
# when unset. SITE_URL (above) is the SEO/social origin; these are the
# email/link origin — set all three to the production origin in production.
# APP_URL=https://www.example.org
# APP_BASE_URL=https://www.example.org

# Secret for signing one-click email-unsubscribe tokens. Falls back to
# JWT_SECRET when unset (src/utils/unsubscribeToken.js); set a distinct value
# to rotate unsubscribe links independently of login sessions.
# UNSUBSCRIBE_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Background workers (started in src/server.js outside NODE_ENV=test). Both
# default to ENABLED; set to "false" to disable. The email worker drains the
# outbound email queue; the reminder worker sends event reminders.
# EMAIL_WORKER_ENABLED=true
# REMINDER_WORKER_ENABLED=true

# ---------------------------------------------------------------------------
# CAPTCHA (hCaptcha) for the public contact form. CAPTCHA_SITE_KEY is rendered
# client-side; CAPTCHA_SECRET verifies the token server-side. Leave unset in
# dev to skip verification.
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=

# ---------------------------------------------------------------------------
# Live-stream embed (homepage "Watch Live"), read by StreamingService.
# FACEBOOK_LIVE_IS_ACTIVE=true forces the live state when EMBED_URL is set;
# SCHEDULED_START (ISO 8601) drives the "upcoming" state when in the future.
# WATCH_URL is the click-through, TITLE labels the player.
# STREAM_PROVIDER_UNAVAILABLE=true short-circuits to the degraded/error state
# (useful for testing the fallback UI).
# FACEBOOK_LIVE_IS_ACTIVE=false
# FACEBOOK_LIVE_EMBED_URL=
# FACEBOOK_LIVE_WATCH_URL=
# FACEBOOK_LIVE_TITLE=Friday Evening Shabbat Service
# FACEBOOK_LIVE_SCHEDULED_START=
# STREAM_PROVIDER_UNAVAILABLE=false
# Auto-expiry safety net: a DB-scheduled stream the admin took live ("Go Live")
# stops showing "LIVE NOW" (and its chat) this many hours after live_started_at,
# so a forgotten "active" stream self-heals. Default 8 — set it ABOVE your longest
# continuous broadcast so a real service is never dropped mid-stream.
# STREAM_MAX_LIVE_HOURS=8

# ---------------------------------------------------------------------------
# Path the backup-status log is read from (src/services/backupLogService.js)
# for the admin backup-health surface. Defaults to a path inside the project
# when unset.
# BACKUP_LOG_FILE=/var/log/web-temple/backup.log

# ---------------------------------------------------------------------------
# Initial admin account bootstrap — read ONLY by `npm run create-admin`
# (scripts/create-admin.js), never by the running server. Set these, run the
# script once, then unset/rotate. ADMIN_EMAIL (above) is the third required
# field for that script.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
