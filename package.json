{
  "name": "web-temple",
  "version": "1.0.0",
  "description": "Temple B'nai Israel Website - Modern, accessible temple website with live streaming and community features",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:leaks": "jest --detectOpenHandles --coverage",
    "test:a11y": "jest --testPathPattern=accessibility.test.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "test:performance": "lhci autorun"
  },
  "keywords": [
    "temple",
    "synagogue",
    "community",
    "live-streaming",
    "accessibility"
  ],
  "author": "Ilya",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.0",
    "pg": "^8.18.0",
    "sanitize-html": "^2.17.0",
    "uuid": "^9.0.1",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "axe-core": "^4.9.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-axe": "^7.0.1",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "lighthouse": "11.0.0"
  }
}
