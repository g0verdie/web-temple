<div class="donations-container">
    <div class="demo-banner" role="status">
        DEMO — simulated payment. No real money is charged. (PayPal goes live after Board approval.)
    </div>

    <h1>Complete your donation</h1>
    <p class="checkout-amount">
        Amount: <strong>$<%= (donation.amountCents / 100).toFixed(2) %></strong>
        <% if (donation.donationType === 'recurring') { %><span class="recurring-note">(monthly)</span><% } %>
    </p>

    <p>Choose a simulated payment outcome to continue:</p>
    <form method="POST" action="/donations/checkout/<%= encodeURIComponent(donation.id) %>/complete" class="checkout-outcomes">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>">
        <button type="submit" name="outcome" value="success" class="btn-primary">Simulate Success</button>
        <button type="submit" name="outcome" value="failure" class="btn-secondary">Simulate Failure</button>
        <button type="submit" name="outcome" value="cancel" class="btn-link">Cancel</button>
    </form>
</div>
