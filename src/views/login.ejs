<div class="container">
    <div class="auth-form-wrapper">
        <h1>Welcome Back</h1>
        <p class="subtitle">Log in to your member account</p>

        <form id="login-form" class="auth-form" aria-label="Login form" action="/api/auth/login" method="post">
            <div class="form-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" required autocomplete="email" aria-required="true">
            </div>

            <div class="form-group">
                <label for="password">Password *</label>
                <input type="password" id="password" name="password" required autocomplete="current-password"
                    aria-required="true">
            </div>

            <div id="error-message" class="error-message" role="alert" aria-live="polite"></div>
            <div id="success-message" class="success-message" role="alert" aria-live="polite"></div>

            <button type="submit" class="btn-primary">Log In</button>
        </form>

        <p class="auth-footer">
            Need an account? <a href="/register">Create one</a>
        </p>
    </div>
</div>

<script src="/js/login.js" defer></script>
