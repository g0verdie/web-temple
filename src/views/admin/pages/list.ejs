<div class="container mt-5">
  <h1>Manage Pages</h1>
  <p class="text-muted">Edit the site's static content pages.</p>

  <% if (pages && pages.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Page</th>
            <th scope="col">Status</th>
            <th scope="col">Last updated</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pages.forEach(function(p) { %>
            <tr>
              <td>
                <strong><%= p.title %></strong>
                <div class="text-muted small">/<%= p.slug %></div>
              </td>
              <td>
                <% if (p.published) { %>
                  <span class="badge bg-success">Published</span>
                <% } else { %>
                  <span class="badge bg-secondary">Draft</span>
                <% } %>
              </td>
              <td><time datetime="<%= p.updated_at ? new Date(p.updated_at).toISOString() : '' %>"><%= p.updated_at ? new Date(p.updated_at).toLocaleDateString() : '' %></time></td>
              <td>
                <a href="/admin/pages/<%= p.slug %>" class="btn btn-sm btn-primary">Edit</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-muted">No editable pages found.</p>
  <% } %>

  <p class="mt-3"><a href="/admin" class="btn btn-outline-secondary">&larr; Back to Dashboard</a></p>
</div>
