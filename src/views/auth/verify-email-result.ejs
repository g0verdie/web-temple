<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body p-4 text-center">
          <% if (ok) { %>
            <h1 class="h3 mb-3 fw-normal">Email verified</h1>
            <% if (already) { %>
              <p class="text-muted mb-4">Your email address is already verified. Your account is awaiting approval by a temple administrator — you'll receive an email once it's approved.</p>
            <% } else { %>
              <p class="text-muted mb-4">Thank you — your email address is confirmed. A temple administrator will review your membership, and you'll receive an email once your account is approved.</p>
            <% } %>
            <a href="/login" class="btn btn-primary">Go to Login</a>
          <% } else { %>
            <h1 class="h3 mb-3 fw-normal">Verification failed</h1>
            <p class="text-muted mb-4"><%= message || 'This verification link is invalid or has expired.' %></p>
            <a href="/auth/resend-verification" class="btn btn-primary">Resend verification email</a>
            <div class="mt-3"><a href="/login" class="text-decoration-none">Back to Login</a></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
