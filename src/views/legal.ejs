<section class="legal-page" role="region" aria-labelledby="legal-heading">
  <div class="container legal-page__container">
    <article class="legal-page__content">
      <h1 id="legal-heading" class="legal-page__title"><%= page.title %></h1>

      <!-- Rich text content from CMS (sanitized on the admin write path) -->
      <div class="prose prose--rich-text">
        <%- page.content %>
      </div>

      <% if (!page.published) { %>
        <div class="alert alert-warning" role="status" aria-live="polite">
          <strong>Draft:</strong> This page is not yet published and is visible only to administrators.
        </div>
      <% } %>
    </article>
  </div>
</section>
