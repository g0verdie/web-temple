<div class="container mt-5">
  <h1>Contact Messages</h1>

  <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success" role="alert"><%= success %></div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

  <form method="GET" action="/admin/messages" class="mb-3" role="search">
    <label for="status">Filter by status</label>
    <select name="status" id="status">
      <option value="" <%= filterStatus === '' ? 'selected' : '' %>>All</option>
      <% ['new', 'read', 'replied', 'archived'].forEach(function (s) { %>
        <option value="<%= s %>" <%= filterStatus === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
    <button type="submit">Apply</button>
  </form>

  <% if (messages && messages.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">From</th>
            <th scope="col">Subject</th>
            <th scope="col">Status</th>
            <th scope="col">Received</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach(function (m) { %>
            <tr>
              <td><%= m.name %><br><span class="text-muted"><%= m.email %></span></td>
              <td><%= m.subject %></td>
              <td><span class="badge bg-secondary"><%= m.status %></span></td>
              <td><time datetime="<%= m.created_at ? new Date(m.created_at).toISOString() : '' %>"><%= m.created_at ? new Date(m.created_at).toLocaleDateString() : '' %></time></td>
              <td><a class="btn btn-sm btn-outline-primary" href="/admin/messages/<%= m.id %>">Open</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-muted">No messages<%= filterStatus ? ' with status &quot;' + filterStatus + '&quot;' : '' %>.</p>
  <% } %>

  <% if (totalPages > 1) { %>
    <nav aria-label="Message pages">
      <% if (currentPage > 1) { %><a href="/admin/messages?page=<%= currentPage - 1 %>&status=<%= encodeURIComponent(filterStatus) %>" rel="prev">Previous</a><% } %>
      <span>Page <%= currentPage %> of <%= totalPages %></span>
      <% if (currentPage < totalPages) { %><a href="/admin/messages?page=<%= currentPage + 1 %>&status=<%= encodeURIComponent(filterStatus) %>" rel="next">Next</a><% } %>
    </nav>
  <% } %>

  <p class="mt-3"><a href="/admin" class="btn btn-outline-secondary">&larr; Back to Dashboard</a></p>
</div>
