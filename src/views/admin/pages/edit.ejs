<div id="main-content" class="admin-pages-edit">
  <div class="admin-container">
    <!-- Header -->
    <div class="admin-header">
      <h1 class="admin-title">Edit Page: <%= page.title %></h1>
      <p class="admin-subtitle">
        Last updated: <time datetime="<%= page.updated_at %>"><%= new Date(page.updated_at).toLocaleDateString() %></time>
        <% if (!page.published) { %>
          <span class="badge badge--warning">Draft</span>
        <% } else { %>
          <span class="badge badge--success">Published</span>
        <% } %>
      </p>
    </div>

    <div class="admin-content-wrapper">
      <!-- Main Editor -->
      <div class="admin-main">
        <!-- Editor Form -->
        <form id="page-edit-form" class="page-edit-form" data-slug="<%= slug %>">
          <div class="form-group">
            <label for="page-title" class="form-label">Page Title</label>
            <input
              type="text"
              id="page-title"
              name="title"
              class="form-input"
              value="<%= page.title %>"
              required
              aria-describedby="title-help"
            />
            <small id="title-help" class="form-help">The page title displayed at the top of the page</small>
          </div>

          <div class="form-group">
            <label for="page-content" class="form-label">Page Content</label>
            <p class="form-help">Use the toolbar below to format your content. You can add headings, bold text, links, images, and lists.</p>

            <!-- Quill Editor -->
            <div id="editor" class="quill-editor" aria-label="Rich text editor for page content"></div>
            <input type="hidden" id="page-content" name="content" />
            <!-- Existing content for the editor to load (HTML-escaped on the server; the
                 textarea's .value decodes it back to the original HTML — CSP-safe, no inline script). -->
            <textarea id="page-content-source" hidden><%= page.content %></textarea>
          </div>

          <!-- Form Actions -->
          <div class="form-actions">
            <button type="button" class="btn btn--primary" id="btn-save" aria-label="Save changes">
              Save Changes
            </button>
            <button type="button" class="btn btn--secondary" id="btn-preview" aria-label="Preview page">
              Preview
            </button>
            <button type="button" class="btn btn--outline" id="btn-cancel" aria-label="Cancel editing">
              Cancel
            </button>
          </div>

          <!-- Publish Section -->
          <div class="publish-section">
            <h3 class="publish-section__title">Publish Settings</h3>
            <div class="publish-actions">
              <% if (page.published) { %>
                <p class="publish-status">This page is currently <strong>published</strong> and visible to the public.</p>
                <button type="button" class="btn btn--warning" id="btn-unpublish">
                  Unpublish Page
                </button>
              <% } else { %>
                <p class="publish-status">This page is currently a <strong>draft</strong> and not visible to the public.</p>
                <button type="button" class="btn btn--success" id="btn-publish">
                  Publish Page
                </button>
              <% } %>
            </div>
          </div>
        </form>
      </div>

      <!-- Sidebar -->
      <aside class="admin-sidebar">
        <!-- Version History -->
        <div class="sidebar-section">
          <h3 class="sidebar-section__title">Version History</h3>
          <p class="sidebar-section__description">Restore a previous version of this page</p>

          <% if (versions && versions.length > 0) { %>
            <div class="version-list">
              <% versions.slice().reverse().forEach((version, index) => { %>
                <div class="version-item">
                  <div class="version-header">
                    <strong class="version-number">Version <%= version.version_number %></strong>
                    <time class="version-date" datetime="<%= version.created_at %>">
                      <%= new Date(version.created_at).toLocaleDateString() %>
                    </time>
                  </div>
                  <button
                    type="button"
                    class="btn btn--text btn--small restore-version-btn"
                    data-version="<%= version.version_number %>"
                    aria-label="Restore to version <%= version.version_number %>"
                  >
                    Restore
                  </button>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="sidebar-section__empty">No version history available</p>
          <% } %>
        </div>

        <!-- Page Info -->
        <div class="sidebar-section">
          <h3 class="sidebar-section__title">Page Information</h3>
          <div class="info-list">
            <div class="info-item">
              <span class="info-label">Page Slug:</span>
              <span class="info-value"><%= slug %></span>
            </div>
            <div class="info-item">
              <span class="info-label">Created:</span>
              <span class="info-value">
                <time datetime="<%= page.created_at %>">
                  <%= new Date(page.created_at).toLocaleDateString() %>
                </time>
              </span>
            </div>
            <div class="info-item">
              <span class="info-label">Updated:</span>
              <span class="info-value">
                <time datetime="<%= page.updated_at %>">
                  <%= new Date(page.updated_at).toLocaleDateString() %>
                </time>
              </span>
            </div>
          </div>
        </div>

        <!-- Help -->
        <div class="sidebar-section">
          <h3 class="sidebar-section__title">Formatting Help</h3>
          <ul class="help-list">
            <li><strong>Headings:</strong> Use H2 and H3 for subheadings</li>
            <li><strong>Bold:</strong> Highlight text and click Bold</li>
            <li><strong>Links:</strong> Select text, click Link, enter URL</li>
            <li><strong>Images:</strong> Click Image icon to upload</li>
            <li><strong>Lists:</strong> Use bullet or numbered list buttons</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>

  <!-- Quill (vendored, served from 'self') + the CSP-safe external editor module.
       quill.snow.css + page-editor.css are injected via the layout stylesheets array. -->
  <script src="/vendor/quill.js"></script>
  <script src="/js/page-editor.js"></script>
</div>
