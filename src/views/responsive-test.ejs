<!-- Responsive Design Test Page -->
<!-- Use Chrome DevTools device emulation to test at different breakpoints -->
<!-- Visit this page after deploying to verify responsive behavior -->

<div class="responsive-test-container" style="padding: 2rem;">
  <h1>Responsive Design Test Page</h1>
  <p style="font-size: 0.875rem; color: #666; margin-bottom: 2rem;">
    Use Chrome DevTools (F12) → Device Toolbar to test at different breakpoints.
    Recommended test widths: 375px (mobile), 768px (tablet), 1200px (desktop)
  </p>

  <!-- Breakpoint Indicator -->
  <div style="padding: 1rem; background-color: #f0f0f0; border-left: 4px solid #d4a574; margin-bottom: 2rem;">
    <h3 style="margin: 0 0 0.5rem 0;">Current Breakpoint</h3>
    <p id="breakpoint-display" style="margin: 0; font-weight: bold;"></p>
  </div>

  <!-- Navigation Test -->
  <section style="margin-bottom: 2rem;">
    <h2>Navigation Test</h2>
    <div style="background-color: #1a365d; color: white; padding: 1rem; border-radius: 4px;">
      <p style="margin: 0; font-size: 0.875rem;">
        ✓ On mobile (<768px): Hamburger menu should be visible. Click to toggle.
      </p>
      <p style="margin: 0.5rem 0 0 0; font-size: 0.875rem;">
        ✓ On tablet/desktop (≥768px): Full navigation menu should be visible inline.
      </p>
      <p style="margin: 0.5rem 0 0 0; font-size: 0.875rem;">
        ✓ Keyboard: Use Tab to focus menu items, Escape to close mobile menu.
      </p>
    </div>
  </section>

  <!-- Touch Target Test -->
  <section style="margin-bottom: 2rem;">
    <h2>Touch Target Test (44px minimum)</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem;">
      <button style="padding: 12px 16px; min-height: 44px; background-color: #d4a574; color: #1a365d; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">
        Test Button
      </button>
      <a href="/" style="padding: 12px 16px; min-height: 44px; display: flex; align-items: center; background-color: #1a365d; color: white; text-decoration: none; border-radius: 4px; font-weight: 600;">
        Test Link
      </a>
    </div>
    <p style="font-size: 0.875rem; color: #666; margin-top: 1rem;">
      Both buttons should be at least 44px tall. They should be easy to tap on mobile.
    </p>
  </section>

  <!-- Form Test -->
  <section style="margin-bottom: 2rem;">
    <h2>Form Touch-Friendliness Test</h2>
    <form style="max-width: 500px;">
      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Test Input Field</label>
        <input type="text" style="width: 100%; padding: 12px 8px; min-height: 44px; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; box-sizing: border-box;" placeholder="Type here...">
        <p style="font-size: 0.875rem; color: #666; margin-top: 0.25rem;">Input should be 44px+ tall for touch targets</p>
      </div>
      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Test Textarea</label>
        <textarea style="width: 100%; padding: 12px 8px; min-height: 120px; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; box-sizing: border-box;" placeholder="Type here..."></textarea>
      </div>
      <button type="submit" style="padding: 12px 16px; min-height: 44px; width: 100%; background-color: #d4a574; color: #1a365d; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; font-size: 1rem;">
        Submit Button (44px)
      </button>
    </form>
  </section>

  <!-- Color Contrast Test -->
  <section style="margin-bottom: 2rem;">
    <h2>Color Contrast Test (4.5:1 minimum WCAG AA)</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
      <div style="padding: 1rem; background-color: white; color: #1a365d; border: 1px solid #ccc; border-radius: 4px;">
        <p><strong>Navy on White</strong></p>
        <p style="font-size: 0.875rem;">Ratio: 9.2:1 ✓</p>
      </div>
      <div style="padding: 1rem; background-color: #1a365d; color: #d4a574; border-radius: 4px;">
        <p><strong>Gold on Navy</strong></p>
        <p style="font-size: 0.875rem;">Ratio: 4.6:1 ✓</p>
      </div>
    </div>
  </section>

  <!-- Zoom Test -->
  <section style="margin-bottom: 2rem;">
    <h2>Zoom Test (200% text zoom)</h2>
    <p>
      Use browser zoom (Ctrl+/Cmd+) to zoom to 200%. 
      <strong>Check that no horizontal scrollbar appears</strong> at any breakpoint.
    </p>
    <p style="font-size: 0.875rem; color: #666;">
      All text should remain readable and responsive layout should adapt.
    </p>
  </section>

  <!-- Image Scaling Test -->
  <section style="margin-bottom: 2rem;">
    <h2>Image Scaling Test (responsive without distortion)</h2>
    <div style="max-width: 100%; border-radius: 4px; overflow: hidden; background-color: #f0f0f0;">
      <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 400'%3E%3Crect fill='%231a365d' width='800' height='400'/%3E%3Ctext x='400' y='200' font-size='40' fill='white' text-anchor='middle' dy='.3em'%3EResponsive Image Area%3C/text%3E%3Ctext x='400' y='250' font-size='20' fill='%23d4a574' text-anchor='middle'%3EScales without distortion%3C/text%3E%3C/svg%3E" alt="Responsive test image" style="width: 100%; height: auto; display: block;">
    </div>
    <p style="font-size: 0.875rem; color: #666; margin-top: 0.5rem;">
      This SVG image scales responsively. Try resizing the window to verify aspect ratio is maintained.
    </p>
  </section>

  <!-- Keyboard Navigation Test -->
  <section style="margin-bottom: 2rem;">
    <h2>Keyboard Navigation Test</h2>
    <div style="background-color: #f0f0f0; padding: 1rem; border-radius: 4px;">
      <p><strong>Test Steps:</strong></p>
      <ol style="margin: 0.5rem 0 0 1.5rem;">
        <li>Press Tab to navigate through all interactive elements</li>
        <li>All focused elements should have a visible 3px outline</li>
        <li>On mobile menu: press Escape to close, arrow keys to navigate items</li>
        <li>Skip-to-main-content link should appear when you Tab on page load</li>
      </ol>
    </div>
  </section>

  <hr style="margin: 2rem 0; border: none; border-top: 1px solid #ccc;">

  <p style="font-size: 0.875rem; color: #666; margin-top: 2rem;">
    <strong>Testing Checklist:</strong> Use this page with Chrome DevTools to verify all responsive design acceptance criteria.
  </p>
</div>

<script>
  // Display current breakpoint
  function updateBreakpointDisplay() {
    const width = window.innerWidth;
    let breakpoint = '';
    
    if (width < 640) {
      breakpoint = `Mobile (${width}px)`;
    } else if (width < 768) {
      breakpoint = `Small Tablet (${width}px)`;
    } else if (width < 1024) {
      breakpoint = `Tablet (${width}px)`;
    } else if (width < 1536) {
      breakpoint = `Desktop (${width}px)`;
    } else {
      breakpoint = `Large Desktop (${width}px)`;
    }
    
    const display = document.getElementById('breakpoint-display');
    if (display) {
      display.textContent = breakpoint;
      // Change color based on breakpoint
      if (width < 768) {
        display.style.color = '#d32f2f'; // Red for mobile
      } else if (width < 1024) {
        display.style.color = '#f57c00'; // Orange for tablet
      } else {
        display.style.color = '#388e3c'; // Green for desktop
      }
    }
  }
  
  // Update on load and resize
  updateBreakpointDisplay();
  window.addEventListener('resize', () => {
    updateBreakpointDisplay();
  });
</script>
