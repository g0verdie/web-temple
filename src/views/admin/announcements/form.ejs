<div class="container announcement-form-wrap"
     data-csrf="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>"
     data-id="<%= announcement ? announcement.id : '' %>">

    <%- include('../partials/back-to-dashboard') %>
    <h1><%= announcement ? 'Edit Announcement' : 'New Announcement' %></h1>

    <div id="announcementFormMessage" class="form-message" role="alert" aria-live="assertive"></div>

    <form id="announcementForm" class="settings-form" novalidate>
        <div class="form-row">
            <label for="announcementTitle">Title</label>
            <input type="text" id="announcementTitle" name="title" maxlength="200" required
                   value="<%= announcement ? announcement.title : '' %>">
        </div>

        <div class="form-row">
            <span id="bodyLabel" class="form-label">Body</span>
            <div class="rte-toolbar" role="toolbar" aria-label="Formatting" aria-controls="announcementBody">
                <button type="button" class="rte-btn" data-command="bold" aria-label="Bold"><strong>B</strong></button>
                <button type="button" class="rte-btn" data-command="italic" aria-label="Italic"><em>I</em></button>
                <button type="button" class="rte-btn" data-command="insertUnorderedList" aria-label="Bulleted list">&bull; List</button>
                <button type="button" class="rte-btn" data-command="createLink" aria-label="Insert link">Link</button>
                <button type="button" class="rte-btn" data-command="insertImage" aria-label="Insert image">Image</button>
            </div>
            <div id="announcementBody" class="rte-editor" contenteditable="true" role="textbox"
                 aria-multiline="true" aria-labelledby="bodyLabel" tabindex="0"><%- announcement ? announcement.body_html : '' %></div>
            <p class="hint">Links and images open in the body. Images require alternative text for accessibility.</p>
        </div>

        <% if (!announcement) { %>
        <div class="form-row">
            <label class="checkbox-row">
                <input type="checkbox" id="announcementFeatured" name="featured">
                Feature this announcement (pinned to the top for 30 days)
            </label>
        </div>
        <% } %>

        <div class="announcement-form-actions">
            <button type="button" id="previewToggle" class="btn btn-outline-secondary" aria-expanded="false" aria-controls="announcementPreview">Preview</button>
            <button type="submit" class="btn btn-primary"><%= announcement ? 'Save Changes' : 'Publish Announcement' %></button>
            <a href="/admin/announcements" class="btn btn-outline-secondary">Cancel</a>
        </div>

        <div id="autosaveStatus" class="hint" role="status" aria-live="polite"></div>
    </form>

    <section id="announcementPreview" class="announcement-preview" aria-labelledby="previewHeading" hidden>
        <h2 id="previewHeading">Preview</h2>
        <article class="announcement-card">
            <h3 id="previewTitle" class="announcement-card__title"></h3>
            <div id="previewBody" class="announcement-card__body"></div>
        </article>
    </section>
</div>

<script src="/js/admin-announcements.js" defer></script>
