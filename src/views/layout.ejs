<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    // Per-page meta with a site-wide default. `description` is optional, so every
    // existing res.render('layout', ...) keeps working untouched.
    const siteName = "Temple B'nai Israel";
    const defaultDescription = "Temple B'nai Israel — a warm, inclusive Jewish community in Florence, AL. Join us for services, streaming, events, and community life.";
    const metaDescription = (typeof description !== 'undefined' && description) ? description : defaultDescription;
    const siteUrl = (typeof baseUrl !== 'undefined' && baseUrl) ? baseUrl : '';
    const canonicalPath = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '';
    const canonicalUrl = siteUrl + canonicalPath;
    const ogImage = siteUrl + '/images/og-share.jpg';
    // Brand the title with the site name unless the page already includes it
    // (auth pages suffix the brand themselves — avoid double-branding).
    const brandedTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
    // Sitewide structured data (schema.org PlaceOfWorship), always emitted.
    const siteJsonLd = {
      '@context': 'https://schema.org',
      '@type': 'PlaceOfWorship',
      name: siteName,
      url: siteUrl || undefined,
      logo: siteUrl + '/images/tbi-logo.png',
      image: ogImage,
      description: metaDescription,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '201 E Hawthorne St',
        addressLocality: 'Florence',
        addressRegion: 'AL',
        postalCode: '35630',
        addressCountry: 'US'
      }
    };
    // Embed JSON safely inside a script tag: escape chars that could break out of
    // the element (a literal closing tag in untrusted data) or confuse the HTML parser.
    const ldJson = (obj) => JSON.stringify(obj)
      .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
  %>
  <meta name="description" content="<%= metaDescription %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %>
    <meta name="robots" content="noindex">
    <% } %>
  <% if (typeof csrfToken !=='undefined' ) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
      <title>
        <%= brandedTitle %>
      </title>
      <link rel="canonical" href="<%= canonicalUrl %>">

      <!-- Open Graph / Facebook -->
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="<%= siteName %>">
      <meta property="og:title" content="<%= brandedTitle %>">
      <meta property="og:description" content="<%= metaDescription %>">
      <meta property="og:url" content="<%= canonicalUrl %>">
      <meta property="og:image" content="<%= ogImage %>">

      <!-- Twitter Card -->
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="<%= brandedTitle %>">
      <meta name="twitter:description" content="<%= metaDescription %>">
      <meta name="twitter:image" content="<%= ogImage %>">

      <link rel="icon" type="image/svg+xml" href="/favicon.svg">
      <!-- Main CSS -->
      <link rel="stylesheet" href="/css/main.css">
      <!-- Shared component kit (I15): loaded globally, before any page-scoped sheet -->
      <link rel="stylesheet" href="/css/components.css">
      <% if (typeof stylesheets !=='undefined' && stylesheets.length) { %>
        <% stylesheets.forEach((stylesheet)=> { %>
          <link rel="stylesheet" href="<%= stylesheet %>">
          <% }) %>
            <% } %>

              <!-- Structured data (schema.org). Server-built JSON, not executable script — CSP-safe as data. -->
              <script type="application/ld+json"><%- ldJson(siteJsonLd) %></script>
              <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
                <script type="application/ld+json"><%- ldJson(jsonLd) %></script>
                <% } %>
</head>

<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <%
    // Active-nav helper + resilient chrome context. `chrome` is populated by the
    // global middleware in server.js on GET page renders; guard so a non-GET
    // re-render (or a direct layout render) degrades to no live/times cue rather
    // than throwing a ReferenceError.
    const activePath = (typeof currentPath !== 'undefined' ? currentPath : '');
    const isActive = (p) => (activePath === p ? ' aria-current="page"' : '');
    const chromeCtx = (typeof chrome !== 'undefined' && chrome)
      ? chrome
      : { liveNow: false, watchUrl: '/watch', serviceTimes: null };
  %>

  <header role="banner" class="site-chrome">
    <!-- Tier 1: utility strip — this week's service time, live-aware Watch. Auth
         (log in / account) lives once in the main nav below, so it is not repeated
         here (avoids two links to the same route with differing accessible names). -->
    <div class="chrome-util">
      <div class="chrome-util__inner">
        <% if (chromeCtx.serviceTimes) { %>
          <span class="chrome-util__times"><%= chromeCtx.serviceTimes %></span>
        <% } %>
        <% if (chromeCtx.liveNow) { %>
          <a href="<%= chromeCtx.watchUrl %>" class="chrome-util__live"><span class="chrome-live-dot" aria-hidden="true"></span>Watch Live</a>
        <% } else { %>
          <a href="<%= chromeCtx.watchUrl %>" class="chrome-util__watch">Watch</a>
        <% } %>
      </div>
    </div>

    <!-- Tier 2: main bar — wordmark, text nav, single gold Give button -->
    <nav role="navigation" aria-label="Main navigation" class="chrome-main">
      <div class="nav-container">
        <button class="hamburger-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <h1 class="site-title">
          <a href="/" class="site-logo-link" aria-label="Temple B'nai Israel — home">
            <img src="/images/tbi-logo.png" alt="Temple B'nai Israel" class="site-logo" width="600" height="137">
            <svg class="site-home-icon" viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
          </a>
        </h1>
        <ul class="nav-menu" id="nav-menu">
          <%# Utility cues folded into the hamburger on mobile (R7): the tier-1 strip
              that carries these is hidden < 768px, so surface the live-now cue and
              service time here. Hidden again from 768px up (.nav-util) where the
              strip takes over, so /watch is never linked twice at one width. %>
          <% if (chromeCtx.liveNow) { %>
          <li class="nav-util"><a href="<%= chromeCtx.watchUrl %>" class="chrome-util__live"><span class="chrome-live-dot" aria-hidden="true"></span>Watch Live</a></li>
          <% } else { %>
          <li class="nav-util"><a href="<%= chromeCtx.watchUrl %>" class="chrome-util__watch">Watch</a></li>
          <% } %>
          <% if (chromeCtx.serviceTimes) { %>
          <li class="nav-util"><span class="chrome-util__times"><%= chromeCtx.serviceTimes %></span></li>
          <% } %>
          <li><a href="/"<%- isActive('/') %>>Home</a></li>
          <li><a href="/calendar"<%- isActive('/calendar') %>>Calendar</a></li>
          <li><a href="/about"<%- isActive('/about') %>>About</a></li>
          <li><a href="/contact"<%- isActive('/contact') %>>Contact</a></li>
          <% if (user) { %>
          <li><a href="/directory"<%- isActive('/directory') %>>Directory</a></li>
          <li><a href="/account/settings"<%- isActive('/account/settings') %>>Account</a></li>
          <% if (user.role === 'admin' || user.role === 'rabbi') { %>
          <li><a href="/admin"<%- isActive('/admin') %>>Admin</a></li>
          <% } %>
          <li><a href="/login" class="nav-logout" id="logout-link">Logout</a></li>
          <% } else { %>
          <li><a href="/login" class="nav-login"<%- isActive('/login') %>>Login</a></li>
          <% } %>
        </ul>
        <a href="/donations" class="chrome-give"<%- isActive('/donations') %>>Give</a>
      </div>
    </nav>
  </header>

  <main id="main-content" role="main">
    <%- include(bodyView, viewData) %>
  </main>

  <footer role="contentinfo" class="site-footer">
    <div class="footer-grid">
      <div class="footer-col footer-col--brand">
        <p class="footer-brand">Temple B'nai Israel</p>
        <p>201 E Hawthorne St<br>Florence, AL 35630</p>
        <%# Placeholder contact details — owner to supply real phone/email before launch.
            Rendered as plain text (no tel:/mailto scheme links): the values are placeholders,
            and a live tel:/mailto here would both mislead visitors and defeat the directory
            privacy guard that asserts pages never emit a member's tel: link. %>
        <p>(256) 555-0100<br>office@example.org</p>
      </div>
      <div class="footer-col">
        <h2 class="footer-heading">Visit</h2>
        <% if (chromeCtx.serviceTimes) { %>
          <p>Next: <%= chromeCtx.serviceTimes %></p>
        <% } %>
        <p>Kabbalat Shabbat · Friday evening</p>
        <p>Shabbat Morning · Saturday morning</p>
      </div>
      <div class="footer-col">
        <h2 class="footer-heading">Explore</h2>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/calendar">Calendar</a>
          <a href="/watch">Watch</a>
          <a href="/donations">Give</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
      <div class="footer-col">
        <h2 class="footer-heading">Congregation</h2>
        <%# Placeholder trust cues — owner to confirm affiliation + real EIN before launch %>
        <p>Affiliated with the Union for Reform Judaism</p>
        <p>A registered 501(c)(3) &middot; EIN 00-0000000</p>
      </div>
    </div>
    <div class="footer-legal">
      <p>&copy; <%= new Date().getFullYear() %> Temple B'nai Israel. All rights reserved.</p>
      <nav class="footer-links" aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
        <a href="/accessibility">Accessibility</a>
      </nav>
    </div>
  </footer>

  <script src="/js/hamburger.js"></script>
  <% if (typeof user !== 'undefined' && user) { %>
    <script src="/js/sessionWarning.js"></script>
    <script src="/js/logout.js"></script>
  <% } %>
</body>

</html>