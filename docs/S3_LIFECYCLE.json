{
    "Rules": [
        {
            "Id": "ExpireDailyBackups",
            "Status": "Enabled",
            "Filter": {
                "Prefix": "backups/daily/"
            },
            "Expiration": {
                "Days": 30
            }
        },
        {
            "Id": "TransitionMonthlyBackupsToGlacier",
            "Status": "Enabled",
            "Filter": {
                "Prefix": "backups/monthly/"
            },
            "Transitions": [
                {
                    "Days": 30,
                    "StorageClass": "GLACIER"
                }
            ]
        },
        {
            "Id": "ExpireMonthlyBackups",
            "Status": "Enabled",
            "Filter": {
                "Prefix": "backups/monthly/"
            },
            "Expiration": {
                "Days": 365
            }
        }
    ]
}